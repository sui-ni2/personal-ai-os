# Server-side only. Copy to .env locally; never commit the real file.
PERSONAL_AI_OS_DATA_DIR=./data
PERSONAL_AI_OS_CORS_ORIGINS=http://localhost:3000
# Delivery contract. The public repository currently starts only in community mode.
# Cloud mode fails closed until account identity, tenant resolution, and billing are wired.
PERSONAL_AI_OS_DEPLOYMENT_MODE=community
PERSONAL_AI_OS_PLAN=community
PERSONAL_AI_OS_TENANT_ID=local
PERSONAL_AI_OS_ACTOR_ID=local-owner
# Required for any public deployment. Keep both values only in the host's secret store.
PERSONAL_AI_OS_REQUIRE_AUTH=false
PERSONAL_AI_OS_ACCESS_PASSWORD=
PERSONAL_AI_OS_SESSION_SECRET=
PERSONAL_AI_OS_ACCESS_SESSION_HOURS=168
PERSONAL_AI_OS_OPENAI_API_KEY=
PERSONAL_AI_OS_ANTHROPIC_API_KEY=
# Optional GitHub token/PAT with Models access. Keep it server-side like any provider credential.
PERSONAL_AI_OS_GITHUB_MODELS_TOKEN=
# Optional independent credential for GPT Live. Falls back to the OpenAI key above.
PERSONAL_AI_OS_REALTIME_API_KEY=
# Compatible gateways must implement the OpenAI multipart WebRTC calls contract.
PERSONAL_AI_OS_REALTIME_ENDPOINT=https://api.openai.com/v1/realtime/calls
PERSONAL_AI_OS_REALTIME_MODEL=gpt-realtime-2.1
PERSONAL_AI_OS_REALTIME_VOICE=marin
PERSONAL_AI_OS_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
PERSONAL_AI_OS_OPENAI_MODELS=gpt-5.1,gpt-4.1-mini
PERSONAL_AI_OS_ANTHROPIC_MODELS=claude-sonnet-4-5,claude-haiku-4-5
PERSONAL_AI_OS_GITHUB_MODELS_MODELS=openai/gpt-4.1
PERSONAL_AI_OS_DEFAULT_PROVIDER=openai
PERSONAL_AI_OS_DEFAULT_MODEL=gpt-5.1
PERSONAL_AI_OS_PROVIDER_TIMEOUT_SECONDS=90
PERSONAL_AI_OS_PROVIDER_MAX_RETRIES=2
PERSONAL_AI_OS_PROVIDER_RETRY_BASE_SECONDS=0.25
# JSON object mapping safe stdio aliases to fixed argv arrays. Example:
# {"my-server":["C:\\absolute\\python.exe","C:\\absolute\\server.py"]}
PERSONAL_AI_OS_MCP_STDIO_COMMANDS={}
NEXT_PUBLIC_API_URL=http://localhost:8000
# Build-time only. Use for an access-controlled, read-only mobile UI preview when
# the API is intentionally absent. Never enable this for a functional deployment.
NEXT_PUBLIC_PERSONAL_AI_OS_MOBILE_PREVIEW=false
